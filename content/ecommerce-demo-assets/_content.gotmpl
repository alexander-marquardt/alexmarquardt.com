{{/*
  Every page under /ecommerce-demo-assets/ is generated from the image
  directories. Nothing here is a list of files and nothing here names a
  section: add a directory of images and its page appears, add images to one
  and its page grows.

  That is the point. These listings were hand-written once, and a hand-written
  list of files is wrong the day after anything is added to the directory it
  describes -- which is how the page this replaced came to list a fraction of
  what it claimed to cover.

    a directory of images       -> one listing page
    a directory of directories  -> an index, plus one listing page each

  So the industrial drawings, which are filed by product type, get an index
  and a page per type without either being declared.

  This decides only WHICH pages exist. What is on them is read from the same
  directories at render time by layouts/partials/asset-*.html -- counting here
  as well would put the same number in two places and let them disagree.
*/}}

{{ $config := $.Site.Params.demoAssets }}
{{ $root := $config.root }}

{{/* Optional per-directory prose, from data/asset_sections.yaml. A directory
     with no entry there still gets its page; the blurb says where the images
     came from, which a directory listing cannot. */}}
{{ $blurbs := $.Site.Data.asset_sections | default dict }}

{{ range os.ReadDir $root }}
  {{ if .IsDir }}
    {{ $section := .Name }}
    {{ $dir := printf "%s/%s" $root $section }}
    {{ $label := $section | replaceRE "[-_]" " " | title }}

    {{ $subdirs := slice }}
    {{ range os.ReadDir $dir }}
      {{ if .IsDir }}{{ $subdirs = $subdirs | append .Name }}{{ end }}
    {{ end }}

    {{ $.AddPage (dict
      "kind" (cond (gt (len $subdirs) 0) "section" "page")
      "path" $section
      "title" $label
      "content" (dict "mediaType" "text/markdown" "value" (index $blurbs $section | default dict).blurb)
      "params" (dict
        "assetdir" $dir
        "asseturl" (printf "%s/%s" $config.url $section)
        "assetparent" $config.page
        "assetparentlabel" $config.title)) }}

    {{ range $subdirs }}
      {{ $.AddPage (dict
        "kind" "page"
        "path" (printf "%s/%s" $section .)
        "title" (. | replaceRE "[-_]" " " | title)
        "params" (dict
          "assetdir" (printf "%s/%s" $dir .)
          "asseturl" (printf "%s/%s/%s" $config.url $section .)
          "assetparent" (printf "%s%s/" $config.page $section)
          "assetparentlabel" $label)) }}
    {{ end }}
  {{ end }}
{{ end }}
